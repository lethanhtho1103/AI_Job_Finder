# Sao chép thành .env; điền credentials thật. Không commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DBNAME?sslmode=require"

# Canonical origin không gồm /api/auth; Production dùng HTTPS.
NEXTAUTH_URL="http://localhost:3000"
# Secret ngẫu nhiên >=32 ký tự, xem README; không dùng secret mẫu cố định.
NEXTAUTH_SECRET=""

# Seed ngoài Development local cần 16–128 ký tự, có hoa/thường/số/ký tự đặc biệt.
# Development local có thể bỏ trống khi NODE_ENV=development.
# Không đặt NODE_ENV=development trên Production/Vercel.
# ADMIN_PASSWORD=""

# Giai đoạn 2–5: chưa sử dụng.
# STORAGE_PROVIDER=""
# STORAGE_BUCKET=""
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# AI_PROVIDER=""
# AI_MODEL=""
# AI_API_KEY=""

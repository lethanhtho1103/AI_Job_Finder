generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  User
  Administrator
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  username        String        @db.VarChar(32)
  usernameKey     String        @unique @db.VarChar(32)
  passwordHash    String        @db.VarChar(256)
  role            Role          @default(User)
  developmentOnly Boolean       @default(false)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  sessions        AuthSession[]
}

// Registry cho việc thu hồi JWT NextAuth, không lưu cookie/token thô.
model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

// Fixed-window counters dùng chung giữa các Vercel Functions.
model AuthRateLimit {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

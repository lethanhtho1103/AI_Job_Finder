# Giai đoạn 0: chỉ cần khi chủ động kiểm tra Neon.
# Sao chép thành .env; thay bằng URL thật lấy từ Neon. Không commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DBNAME?sslmode=require"

# Giai đoạn 1: chưa sử dụng; bổ sung khi triển khai Better Auth và email.
# BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_SECRET=""
# EMAIL_FROM=""
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""

# Giai đoạn 2–5: chưa sử dụng; provider được chọn ở giai đoạn tương ứng.
# STORAGE_PROVIDER=""
# STORAGE_BUCKET=""
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# AI_PROVIDER=""
# AI_MODEL=""
# AI_API_KEY=""
